DATABASE_URL=
NEXTAUTH_SECRET=
APP_BASE_URL=http://localhost:3000
QUESTIONNAIRE_TOKEN_SECRET=
TERMS_VERSION=2026-05
PRIVACY_VERSION=2026-05
SMS_PROVIDER=mock
SMS_BASE_URL=https://sms.example.com
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
PHONE_NOTIFICATION_CHANNEL=SMS
# SMS real (paso 17): usar SMS_PROVIDER=twilio y SMS_BASE_URL=https://api.twilio.com.
# Configura un Messaging Service o un numero remitente.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE_NUMBER=
# WhatsApp Business oficial (paso 17): usar WHATSAPP_PROVIDER=twilio.
# Para que las notificaciones a telefono salgan por WhatsApp en vez de SMS,
# usar PHONE_NOTIFICATION_CHANNEL=WHATSAPP solo con consentimiento/politica lista.
# Requiere sender oficial de Twilio, consentimiento y plantillas aprobadas
# cuando apliquen. Nunca usar automatizacion no oficial tipo whatsapp-web.js.
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM_PHONE_NUMBER=
# Email transaccional. Para correo real usa EMAIL_PROVIDER=resend y https://api.resend.com.
EMAIL_PROVIDER=mock
EMAIL_BASE_URL=https://email.example.com
EMAIL_API_KEY=
EMAIL_FROM=no-responder@midoc.example.com
NOTIFICATION_CRON_SECRET=
PAYMENTS_PROVIDER=MOCK
PAYMENTS_WEBHOOK_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
# Opcional: si falta, el mapa del perfil publico muestra direccion + enlace a Google Maps.
GOOGLE_MAPS_EMBED_API_KEY=
# Reenfoque 2026-09-07: modulos congelados (agenda publica, perfil publico,
# portal del paciente, buzon, notificaciones). Apagado por omision.
MIDOC_FROZEN_SCOPE=false
# Preconsulta guiada por IA (paso 19, rebanada 8). fake (default) | openai | anthropic | gemini.
# Las llaves solo se usan con su proveedor; proveedores reales requieren BAA para PHF real.
AI_PROVIDER=fake
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Licencia de compra unica (paso 29). Semilla Ed25519 (base64, 32 bytes) y su id;
# se generan con `npm run license:keygen`. Sin ellas el portal no emite
# licencias. La semilla es secreta: solo en .env.local o en los secretos del
# despliegue. La llave publica correspondiente se fija en la app
# (MIDOC_LICENSE_PUBKEYS al compilar; en desarrollo, en src-tauri/.env).
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KID=
# Pasarela de IA de texto (paso 30). none (default) | fake (solo desarrollo) | gemini | openai.
# Un proveedor real usa GEMINI_API_KEY u OPENAI_API_KEY y exige AI_GATEWAY_BAA_APPROVED=true
# (BAA / retencion cero verificados fuera de banda). Modelos separados por coma; el primero es el
# predeterminado.
AI_GATEWAY_PROVIDER=none
AI_GATEWAY_MODELS=
AI_GATEWAY_BAA_APPROVED=false
