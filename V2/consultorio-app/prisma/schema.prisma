// ---------- Sincronizacion con la app de escritorio (13_contrato_sincronizacion.md) ----------

enum SyncDeviceStatus {
  ACTIVE
  REVOKED
}

enum SyncEventType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PRECHECKIN_SUBMITTED
  DOCUMENT_UPLOADED
}

enum MailboxDocumentStatus {
  PENDING
  PURGED
}

enum AuthorizedSummaryStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PURGED
}

model SyncDevice {
  id         String           @id @default(cuid())
  doctorId   String
  doctor     User             @relation("DoctorSyncDevices", fields: [doctorId], references: [id], onDelete: Cascade)
  tokenHash  String           @unique
  deviceName String?
  // Llave publica X25519 (base64) del medico para cifrar documentos del buzon
  // (sealed box E2E, paso 6). Clase: OPERATIVO (material publico de llave).
  documentPublicKey String?
  status     SyncDeviceStatus @default(ACTIVE)
  cursor     Int              @default(0)
  lastSyncAt DateTime?
  createdAt  DateTime         @default(now())
  revokedAt  DateTime?

  @@index([doctorId, status])
}

model SyncEvent {
  id          String        @id @default(cuid())
  doctorId    String
  doctor      User          @relation("DoctorSyncEvents", fields: [doctorId], references: [id], onDelete: Cascade)
  seq         Int
  type        SyncEventType
  // CLINICO en transito para PRECHECKIN_SUBMITTED; se purga tras ACK.
  // CONTACTO/OPERATIVO para eventos de cita.
  payload     Json?
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
  purgedAt    DateTime?

  @@unique([doctorId, seq])
  @@index([doctorId, deliveredAt])
}

// Buzon temporal de documentos del paciente (paso 6, Fase B). El ciphertext es
// un sealed box (X25519) que la nube NO puede leer; se entrega a la app del
// medico via sync y se purga tras el ACK (frontera legal de residencia).
model MailboxDocument {
  id            String                @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String?
  uploadLinkId  String
  category      DocumentCategory      @default(OTHER)
  // CLINICO en transito. Nulo tras la purga; metadatos (nombre, tipo) viajan
  // dentro del sealed box, nunca en claro en la nube.
  ciphertext    Bytes?
  sizeBytes     Int
  status        MailboxDocumentStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  deliveredAt   DateTime?
  purgedAt      DateTime?
  doctor        User                  @relation("DoctorMailboxDocuments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  uploadLink    DocumentUploadLink    @relation(fields: [uploadLinkId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
}

// Resumen clinico que el medico autoriza explicitamente al paciente (paso 6).
// Va app -> nube cifrado con secretbox; la llave viaja SOLO en el fragmento del
// enlace (#k=...), nunca al servidor: la nube guarda ciphertext que no puede
// abrir. Enlace temporal con expiracion; se purga al expirar/revocar.
model AuthorizedSummary {
  id            String                  @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String?
  token         String                  @unique
  // CLINICO en transito. Nulo tras la purga.
  ciphertext    Bytes?
  mimeType      String                  @default("application/pdf")
  title         String?
  sizeBytes     Int
  status        AuthorizedSummaryStatus @default(ACTIVE)
  downloadCount Int                     @default(0)
  expiresAt     DateTime
  createdAt     DateTime                @default(now())
  revokedAt     DateTime?
  purgedAt      DateTime?
  doctor        User                    @relation("DoctorAuthorizedSummaries", fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId, status])
  @@index([patientId, status])
}
