{
  "name": "desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "node --test src/*.test.ts",
    "test:medication": "node --test scripts/medication-reference/*.test.ts",
    "medication:build": "node scripts/medication-reference/build.ts",
    "test:cie10": "node --test scripts/cie10/*.test.ts",
    "cie10:build": "node scripts/cie10/build.ts",
    "test:cnis": "node --test scripts/cnis/*.test.ts",
    "cnis:build": "node scripts/cnis/build.ts",
    "test:ingredients": "node --test scripts/ingredients/*.test.ts",
    "ingredients:build": "node scripts/ingredients/build.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node ./scripts/tauri-dev.mjs --features whisper-local",
    "tauri:build": "tauri build --features whisper-local",
    "tauri:dev:diarize": "tauri dev --release --features \"whisper-local diarization-local\"",
    "tauri:build:diarize": "tauri build --features \"whisper-local diarization-local\"",
    "tauri:dev:openblas": "tauri dev --release --features \"whisper-local whisper-openblas\"",
    "tauri:dev:vulkan": "tauri dev --release --features \"whisper-local whisper-vulkan whisper-openblas\"",
    "tauri:dev:metal": "tauri dev --release --features \"whisper-local whisper-metal\"",
    "tauri:dev:cuda": "tauri dev --release --features \"whisper-cuda diarization-local\"",
    "tauri:build:vulkan": "tauri build --features \"whisper-local whisper-vulkan whisper-openblas diarization-local\"",
    "tauri:build:metal": "tauri build --features \"whisper-local whisper-metal diarization-local\"",
    "tauri:build:cuda": "tauri build --features \"whisper-cuda diarization-local\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.0.4"
  }
}
